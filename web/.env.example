# Salin ke web/.env.local. Hanya kunci anon (publik); service_role TIDAK PERNAH di sini.
# Supabase lokal JukirHub memakai port 55321 (lihat supabase/config.toml), supaya tidak bentrok dengan Adami.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=
# Opsional: alamat situs untuk canonical, sitemap, Open Graph (bawaan: SITUS.urlBawaan di lib/konten-beranda.js)
VITE_SITE_URL=
